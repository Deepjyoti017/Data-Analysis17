-- 5) Which is the most liked cuisine?

SELECT 
    restaurants.Cuisine,
    COUNT(orders.Customer_Rating_Food) AS ratings
FROM
    restaurants
        JOIN
    orders ON restaurants.Restaurant_ID = orders.Restaurant_ID
GROUP BY restaurants.Cuisine
ORDER BY ratings DESC
LIMIT 1


